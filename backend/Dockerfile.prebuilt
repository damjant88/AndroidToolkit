# Lightweight Dockerfile - uses pre-built JAR
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY backend/build/libs/*.jar app.jar

EXPOSE 8080

ENV SPRING_PROFILES_ACTIVE=saas
ENV DATABASE_URL=jdbc:postgresql://postgres:5432/androidtoolkit
ENV DATABASE_USERNAME=androidtoolkit
ENV DATABASE_PASSWORD=devpassword
ENV STORAGE_ENDPOINT=http://minio:9000
ENV STORAGE_BUCKET=androidtoolkit
ENV STORAGE_ACCESS_KEY=minioadmin
ENV STORAGE_SECRET_KEY=minioadmin
ENV JWT_SECRET=dev-secret-key-at-least-32-characters-long
ENV CORS_ALLOWED_ORIGINS=*

ENTRYPOINT ["java", "-jar", "app.jar"]
